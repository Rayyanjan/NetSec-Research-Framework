   "source": [
    "# FU-IDS Experiments — CIC IoMT 2024 (v2.1)\n",
    "\n",
    "**Paper:** *FU-IDS: A Federated Unlearning Framework for Distributed Intrusion Detection Systems with Adversarial Unlearning Defense*\n",
    "\n",
    "**Authors:** M. R. Jan (29200), T. Tahir (29203), A. M. Ghori (29220) — May 2026\n",
    "\n",
    "## v2.1 changes vs v2\n",
    "1. **Native CIC IoMT 2024 loader** — recognizes `*_train.pcap.csv` / `*_test.pcap.csv` naming and derives labels from filenames\n",
    "2. **Robust BENIGN / DDoS detection** — handles `Benign`, `BENIGN`, `benign` and any `*DoS*` / `*DDoS*` label\n",
    "3. **All v2 fixes retained** — backdoor + replacement poisoning, norm-clipped DP\n",
    "\n",
    "## Quick start\n",
    "1. Upload your CIC IoMT 2024 CSVs (e.g. `Benign_train.pcap.csv`, `ARP_Spoofing_train.pcap.csv`, `TCP_IP-DDoS-ICMP1_train.pcap.csv`, etc.) to Colab session\n",
    "2. Runtime → Change runtime type → **T4 GPU**\n",
    "3. **Runtime → Run all** (Ctrl+F9)\n",
    "4. Paste final summary back to me"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Cell 1 — Setup, configuration, seeds"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os, sys, time, json, math, random, copy, glob, re\n",
    "from dataclasses import dataclass\n",
    "from typing import List, Dict, Tuple\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "import torch.nn.functional as F\n",
    "from torch.utils.data import DataLoader, TensorDataset\n",
    "from sklearn.preprocessing import StandardScaler, LabelEncoder\n",
    "from sklearn.model_selection import train_test_split\n",
    "from sklearn.metrics import f1_score, accuracy_score, roc_auc_score\n",
    "from sklearn.decomposition import PCA\n",
    "\n",
    "SEED = 42\n",
    "random.seed(SEED); np.random.seed(SEED); torch.manual_seed(SEED)\n",
    "if torch.cuda.is_available(): torch.cuda.manual_seed_all(SEED)\n",
    "DEVICE = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n",
    "print(f'Device: {DEVICE}  |  PyTorch: {torch.__version__}')\n",
    "\n",
    "FULL_EXPERIMENT = False\n",
    "\n",
    "@dataclass\n",
    "class Config:\n",
    "    n_samples: int = 200_000 if FULL_EXPERIMENT else 60_000\n",
    "    test_frac: float = 0.2\n",
    "    n_clients: int = 20 if FULL_EXPERIMENT else 10\n",
    "    n_rounds: int = 50 if FULL_EXPERIMENT else 30\n",
    "    local_epochs: int = 2\n",
    "    batch_size: int = 256\n",
    "    lr: float = 1e-3\n",
    "    hidden: int = 128 if FULL_EXPERIMENT else 64\n",
    "    n_layers: int = 2\n",
    "    dropout: float = 0.2\n",
    "    focal_gamma: float = 2.0\n",
    "    poison_alpha: float = 0.20\n",
    "    poison_rounds: int = 25\n",
    "    replacement_boost: float = 5.0\n",
    "    window_W: int = 10\n",
    "    pca_components: int = 8\n",
    "    trust_tau: float = 0.65\n",
    "    dp_epsilon: float = 1.0\n",
    "    dp_delta: float = 1e-5\n",
    "    dp_clip_norm: float = 0.05\n",
    "\n",
    "CFG = Config()\n",
    "print('Configuration:'); [print(f'  {k}: {v}') for k, v in CFG.__dict__.items()]"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Cell 2 — CIC IoMT 2024 loader (multi-CSV, label-from-filename)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def find_iomt_csvs():\n",
    "    \"\"\"Find CIC IoMT 2024 / CICIoT2023 style CSVs in cwd.\n",
    "    Patterns: '*_train.pcap.csv', '*_test.pcap.csv', or any pcap-csv that contains an attack name keyword.\"\"\"\n",
    "    candidates = []\n",
    "    for f in os.listdir('.'):\n",
    "        if not f.lower().endswith('.csv'): continue\n",
    "        if '.pcap' in f.lower() or '_train' in f.lower() or '_test' in f.lower():\n",
    "            candidates.append(f)\n",
    "        elif any(kw in f.lower() for kw in ['benign', 'arp', 'mqtt', 'ddos', 'spoof', 'recon', 'scanning', 'syn', 'icmp', 'malformed']):\n",
    "            candidates.append(f)\n",
    "    return sorted(candidates)\n",
    "\n",
    "def label_from_filename(fname: str) -> str:\n",
    "    \"\"\"Derive class label from CIC IoMT 2024 file name.\n",
    "    Examples: 'Benign_train.pcap.csv' -> 'Benign', 'TCP_IP-DDoS-ICMP1_train.pcap.csv' -> 'DDoS-ICMP1'\n",
    "    Strips train/test suffix and pcap extension; collapses common prefixes.\"\"\"\n",
    "    name = fname\n",
    "    # remove .csv and .pcap.csv\n",
    "    name = re.sub(r'\\.pcap\\.csv$', '', name, flags=re.I)\n",
    "    name = re.sub(r'\\.csv$', '', name, flags=re.I)\n",
    "    # strip _train / _test suffix\n",
    "    name = re.sub(r'_(train|test)$', '', name, flags=re.I)\n",
    "    # collapse 'TCP_IP-' prefix into a cleaner label\n",
    "    name = re.sub(r'^TCP_IP-', '', name)\n",
    "    return name\n",
    "\n",
    "def load_iomt_dataset(csv_files: List[str], target_total: int = CFG.n_samples) -> Tuple[pd.DataFrame, List[str]]:\n",
    "    \"\"\"Load multiple per-attack CSVs, attach Label from filename, sample to target_total.\"\"\"\n",
    "    print(f'Loading {len(csv_files)} CSV(s)...')\n",
    "    parts = []\n",
    "    for fp in csv_files:\n",
    "        try:\n",
    "            label = label_from_filename(fp)\n",
    "            df_part = pd.read_csv(fp, low_memory=False)\n",
    "            df_part.columns = [c.strip() for c in df_part.columns]\n",
    "            # Sometimes the CSV already has a Label/label column — overwrite with filename label for consistency\n",
    "            df_part['Label'] = label\n",
    "            parts.append(df_part)\n",
    "            print(f'  {fp:>50s}  rows={len(df_part):>9,d}  label={label}')\n",
    "        except Exception as e:\n",
    "            print(f'  WARN: skip {fp} ({e})')\n",
    "    if not parts:\n",
    "        return None, []\n",
    "    big = pd.concat(parts, ignore_index=True)\n",
    "    # If train/test files are duplicated, drop dupes\n",
    "    big = big.replace([np.inf, -np.inf], np.nan).dropna()\n",
    "    # Stratified subsample to target size\n",
    "    if len(big) > target_total:\n",
    "        big = big.groupby('Label', group_keys=False).apply(\n",
    "            lambda g: g.sample(n=min(len(g), max(50, int(target_total * len(g) / len(big)))), random_state=SEED))\n",
    "    classes_ = sorted(big['Label'].unique().tolist())\n",
    "    return big, classes_\n",
    "\n",
    "csv_files = find_iomt_csvs()\n",
    "print(f'Detected {len(csv_files)} candidate CSV(s) in working directory.')\n",
    "if csv_files:\n",
    "    df, classes = load_iomt_dataset(csv_files)\n",
    "    DATA_SOURCE = 'CIC_IoMT_2024'\n",
    "else:\n",
    "    raise RuntimeError('No CIC IoMT 2024 CSV files found. Upload them to the Colab session and re-run this cell.')\n",
    "\n",
    "print(f'\\nDataset: {DATA_SOURCE}'); print(f'Total rows: {len(df):,}')\n",
    "print(f'Classes ({len(classes)}): {classes}')\n",
    "print('\\nClass distribution:'); print(df['Label'].value_counts(normalize=True).round(4).to_string())"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Cell 3 — Preprocess and partition into non-IID FL clients"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "label_enc = LabelEncoder().fit(df['Label'].astype(str))\n",
    "y_all = label_enc.transform(df['Label'].astype(str))\n",
    "feat_cols = [c for c in df.columns if c != 'Label']\n",
    "X_all = df[feat_cols].select_dtypes(include=[np.number]).values.astype(np.float32)\n",
    "X_all = StandardScaler().fit_transform(X_all)\n",
    "n_features = X_all.shape[1]; n_classes = len(label_enc.classes_)\n",
    "print(f'X shape: {X_all.shape}  |  n_classes: {n_classes}')\n",
    "print(f'Encoded class order: {list(label_enc.classes_)}')\n",
    "\n",
    "# Robust BENIGN / DDoS detection\n",
    "def find_class_idx(class_list, keywords):\n",
    "    for i, c in enumerate(class_list):\n",
    "        if any(kw.lower() in c.lower() for kw in keywords):\n",
    "            return i\n",
    "    return 0\n",
    "\n",
    "BENIGN_IDX = find_class_idx(label_enc.classes_, ['benign', 'normal'])\n",
    "DDOS_IDX = find_class_idx(label_enc.classes_, ['ddos', 'dos'])\n",
    "if DDOS_IDX == BENIGN_IDX:  # fallback to second class if no DDoS found\n",
    "    DDOS_IDX = (BENIGN_IDX + 1) % n_classes\n",
    "print(f'BENIGN class: idx={BENIGN_IDX} → \"{label_enc.classes_[BENIGN_IDX]}\"')\n",
    "print(f'DDoS class:   idx={DDOS_IDX} → \"{label_enc.classes_[DDOS_IDX]}\"  (used as backdoor target)')\n",
    "\n",
    "X_tr, X_te, y_tr, y_te = train_test_split(X_all, y_all, test_size=CFG.test_frac, random_state=SEED, stratify=y_all)\n",
    "print(f'Train: {X_tr.shape}  Test: {X_te.shape}')\n",
    "\n",
    "def non_iid_partition(X, y, n_clients, alpha=0.5, seed=SEED):\n",
    "    rng = np.random.RandomState(seed)\n",
    "    n_classes_ = int(y.max() + 1)\n",
    "    label_idx = [np.where(y == c)[0] for c in range(n_classes_)]\n",
    "    proportions = rng.dirichlet([alpha] * n_clients, size=n_classes_)\n",
    "    client_idx = [[] for _ in range(n_clients)]\n",
    "    for c, idx in enumerate(label_idx):\n",
    "        rng.shuffle(idx)\n",
    "        cuts = (np.cumsum(proportions[c]) * len(idx)).astype(int)[:-1]\n",
    "        for k, s in enumerate(np.split(idx, cuts)):\n",
    "            client_idx[k].extend(s.tolist())\n",
    "    return [np.array(ci) for ci in client_idx]\n",
    "\n",
    "client_indices = non_iid_partition(X_tr, y_tr, CFG.n_clients, alpha=0.5)\n",
    "for i, idx in enumerate(client_indices):\n",
    "    if len(idx) == 0:\n",
    "        client_indices[i] = np.random.choice(len(X_tr), size=max(100, len(X_tr) // (CFG.n_clients * 5)), replace=False)\n",
    "print(f'Per-client sample counts: {[len(i) for i in client_indices]}')\n",
    "\n",
    "client_data = []\n",
    "for idx in client_indices:\n",
    "    Xc = torch.tensor(X_tr[idx], dtype=torch.float32)\n",
    "    yc = torch.tensor(y_tr[idx], dtype=torch.long)\n",
    "    client_data.append((Xc, yc))\n",
    "X_te_t = torch.tensor(X_te, dtype=torch.float32); y_te_t = torch.tensor(y_te, dtype=torch.long)\n",
    "print('Client data ready.')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Cell 4 — BiLSTM-Attention IDS model + utilities"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "class BiLSTMAttnIDS(nn.Module):\n",
    "    def __init__(self, n_features, n_classes, hidden=CFG.hidden, n_layers=CFG.n_layers, dropout=CFG.dropout):\n",
    "        super().__init__()\n",
    "        self.feat_proj = nn.Linear(n_features, hidden * 4)\n",
    "        self.lstm = nn.LSTM(hidden, hidden, num_layers=n_layers, batch_first=True,\n",
    "                            bidirectional=True, dropout=dropout if n_layers > 1 else 0)\n",
    "        self.attn = nn.Linear(hidden * 2, 1)\n",
    "        self.head = nn.Sequential(nn.Dropout(dropout), nn.Linear(hidden * 2, n_classes))\n",
    "    def forward(self, x):\n",
    "        h = self.feat_proj(x).view(x.size(0), 4, -1)\n",
    "        out, _ = self.lstm(h)\n",
    "        a = torch.softmax(self.attn(out).squeeze(-1), dim=-1)\n",
    "        z = (out * a.unsqueeze(-1)).sum(dim=1)\n",
    "        return self.head(z)\n",
    "\n",
    "def focal_loss(logits, target, gamma=CFG.focal_gamma):\n",
    "    ce = F.cross_entropy(logits, target, reduction='none')\n",
    "    p = torch.exp(-ce)\n",
    "    return ((1 - p) ** gamma * ce).mean()\n",
    "\n",
    "def evaluate(model, X, y, bs=1024):\n",
    "    model.eval(); preds = []\n",
    "    loader = DataLoader(TensorDataset(X, y), batch_size=bs)\n",
    "    with torch.no_grad():\n",
    "        for xb, _ in loader:\n",
    "            preds.append(model(xb.to(DEVICE)).argmax(1).cpu().numpy())\n",
    "    p = np.concatenate(preds); yn = y.numpy()\n",
    "    acc = accuracy_score(yn, p) * 100\n",
    "    f1 = f1_score(yn, p, average='macro') * 100\n",
    "    fpr = float(((p != yn) & (yn == BENIGN_IDX)).sum()) / max(1, (yn == BENIGN_IDX).sum()) * 100\n",
    "    return acc, f1, fpr\n",
    "\n",
    "def evaluate_backdoor_asr(model, X, y, src_class=None, tgt_class=None, bs=1024):\n",
    "    src_class = BENIGN_IDX if src_class is None else src_class\n",
    "    tgt_class = DDOS_IDX if tgt_class is None else tgt_class\n",
    "    model.eval(); preds = []\n",
    "    loader = DataLoader(TensorDataset(X, y), batch_size=bs)\n",
    "    with torch.no_grad():\n",
    "        for xb, _ in loader:\n",
    "            preds.append(model(xb.to(DEVICE)).argmax(1).cpu().numpy())\n",
    "    p = np.concatenate(preds); yn = y.numpy()\n",
    "    src_mask = (yn == src_class)\n",
    "    if src_mask.sum() == 0: return 0.0\n",
    "    return float(((p == tgt_class) & src_mask).sum()) / src_mask.sum() * 100\n",
    "\n",
    "_m = BiLSTMAttnIDS(n_features, n_classes).to(DEVICE)\n",
    "print(f'Model params: {sum(p.numel() for p in _m.parameters()):,}')\n",
    "del _m"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Cell 5 — FL engine with backdoor + replacement poisoning"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def get_state_vec(model):\n",
    "    return torch.cat([p.detach().flatten() for p in model.parameters()]).cpu()\n",
    "\n",
    "def set_state_vec(model, vec):\n",
    "    off = 0\n",
    "    for p in model.parameters():\n",
    "        n = p.numel()\n",
    "        p.data.copy_(vec[off:off+n].view_as(p).to(p.device))\n",
    "        off += n\n",
    "\n",
    "def local_train(model, X, y, epochs, lr, bs, poison_mode=None,\n",
    "                src_class=None, tgt_class=None):\n",
    "    src_class = BENIGN_IDX if src_class is None else src_class\n",
    "    tgt_class = DDOS_IDX if tgt_class is None else tgt_class\n",
    "    pre = get_state_vec(model)\n",
    "    y_train = y.clone()\n",
    "    if poison_mode == 'backdoor_replacement':\n",
    "        y_train[y_train == src_class] = tgt_class\n",
    "    opt = torch.optim.Adam(model.parameters(), lr=lr)\n",
    "    loader = DataLoader(TensorDataset(X, y_train), batch_size=bs, shuffle=True)\n",
    "    model.train()\n",
    "    for _ in range(epochs):\n",
    "        for xb, yb in loader:\n",
    "            xb, yb = xb.to(DEVICE), yb.to(DEVICE)\n",
    "            opt.zero_grad(); loss = focal_loss(model(xb), yb); loss.backward(); opt.step()\n",
    "    post = get_state_vec(model)\n",
    "    delta = post - pre\n",
    "    if poison_mode == 'backdoor_replacement':\n",
    "        delta = delta * CFG.replacement_boost\n",
    "    return post, delta\n",
    "\n",
    "def fed_avg(deltas, weights):\n",
    "    weights = np.array(weights, dtype=np.float64); weights = weights / weights.sum()\n",
    "    out = torch.zeros_like(deltas[0])\n",
    "    for d, w in zip(deltas, weights): out += d * float(w)\n",
    "    return out\n",
    "\n",
    "class GradientWindow:\n",
    "    def __init__(self, n_clients, window=CFG.window_W):\n",
    "        self.W = window; self.buf = {i: [] for i in range(n_clients)}\n",
    "    def push(self, cid, delta):\n",
    "        self.buf[cid].append(delta.detach().clone())\n",
    "        if len(self.buf[cid]) > self.W: self.buf[cid].pop(0)\n",
    "    def history(self, cid): return self.buf[cid]\n",
    "\n",
    "def run_fl(global_model, n_rounds, poisoning_clients=(), record_window=None, log_every=5):\n",
    "    history = {'round': [], 'acc': [], 'f1': [], 'fpr': [], 'asr_backdoor': []}\n",
    "    for r in range(n_rounds):\n",
    "        deltas, weights = [], []\n",
    "        gvec = get_state_vec(global_model)\n",
    "        for cid in range(CFG.n_clients):\n",
    "            local = copy.deepcopy(global_model)\n",
    "            Xc, yc = client_data[cid]\n",
    "            mode = 'backdoor_replacement' if (cid in poisoning_clients and r < CFG.poison_rounds) else None\n",
    "            _, delta = local_train(local, Xc, yc, CFG.local_epochs, CFG.lr, CFG.batch_size, poison_mode=mode)\n",
    "            deltas.append(delta); weights.append(len(yc))\n",
    "            if record_window is not None: record_window.push(cid, delta)\n",
    "        agg = fed_avg(deltas, weights)\n",
    "        set_state_vec(global_model, gvec + agg)\n",
    "        if (r + 1) % log_every == 0 or r == n_rounds - 1:\n",
    "            acc, f1, fpr = evaluate(global_model, X_te_t, y_te_t)\n",
    "            asr = evaluate_backdoor_asr(global_model, X_te_t, y_te_t)\n",
    "            history['round'].append(r+1); history['acc'].append(acc); history['f1'].append(f1)\n",
    "            history['fpr'].append(fpr); history['asr_backdoor'].append(asr)\n",
    "            print(f'  round {r+1:3d}/{n_rounds}  acc={acc:.2f}%  F1={f1:.2f}  FPR={fpr:.2f}%  Backdoor-ASR={asr:.2f}%')\n",
    "    return history\n",
    "\n",
    "print('FL engine ready (v2.1: backdoor+replacement poisoning, robust class detection).')"
   ]
  },
  {
   "cell_type": "markdown",
