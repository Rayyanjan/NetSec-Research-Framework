   "source": [
    "## Cell 9 — Scenario D: BadUnlearn vs UnlearnGuard"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def badunlearn_craft(window, target_cids, inflation=5.0):\n",
    "    forged = copy.deepcopy(window)\n",
    "    for cid in target_cids:\n",
    "        for i, d in enumerate(forged.buf[cid]):\n",
    "            forged.buf[cid][i] = d * inflation + torch.randn_like(d) * 0.05\n",
    "    return forged\n",
    "\n",
    "def unlearnguard_filter(window, target_cids, pca_components=CFG.pca_components, tau=CFG.trust_tau):\n",
    "    filtered = copy.deepcopy(window)\n",
    "    honest = []\n",
    "    for cid, hist in window.buf.items():\n",
    "        if cid not in target_cids and len(hist) > 0: honest.append(hist[-1].numpy())\n",
    "    if not honest: return filtered\n",
    "    H = np.stack(honest, axis=0)\n",
    "    pca = PCA(n_components=min(pca_components, max(1, H.shape[0]-1)))\n",
    "    Hp = pca.fit_transform(H); centroid = Hp.mean(axis=0)\n",
    "    centroid_norm = centroid / (np.linalg.norm(centroid) + 1e-9)\n",
    "    for cid in target_cids:\n",
    "        new_hist = []\n",
    "        for d in filtered.buf[cid]:\n",
    "            v = pca.transform(d.numpy()[None, :])[0]\n",
    "            v_norm = v / (np.linalg.norm(v) + 1e-9)\n",
    "            cos = float(np.dot(v_norm, centroid_norm))\n",
    "            new_hist.append(d if cos >= tau else torch.zeros_like(d))\n",
    "        filtered.buf[cid] = new_hist\n",
    "    return filtered\n",
    "\n",
    "print('=== Scenario D — Adversarial Unlearning (BadUnlearn) ===')\n",
    "win_bad = badunlearn_craft(win_B, poison_ids, inflation=5.0)\n",
    "calib_nodef = slidefu_calibrate(STATE_POISONED, win_bad, poison_ids, client_sizes)\n",
    "model_D1 = BiLSTMAttnIDS(n_features, n_classes).to(DEVICE); set_state_vec(model_D1, calib_nodef)\n",
    "acc_D1, f1_D1, _ = evaluate(model_D1, X_te_t, y_te_t)\n",
    "asr_D1 = evaluate_backdoor_asr(model_D1, X_te_t, y_te_t)\n",
    "denom = max(abs(acc_C - acc_B), 1.0)  # safer than 1e-6 — if no real recovery, ASR is ill-defined\n",
    "recovery_prevented_nodef = max(0.0, min(100.0, (acc_C - acc_D1) / denom * 100))\n",
    "print(f'No defense:  acc={acc_D1:.2f}%  Backdoor-ASR={asr_D1:.2f}%  Unlearn-ASR={recovery_prevented_nodef:.1f}%')\n",
    "\n",
    "win_filt = unlearnguard_filter(win_bad, poison_ids)\n",
    "calib_def = slidefu_calibrate(STATE_POISONED, win_filt, poison_ids, client_sizes)\n",
    "model_D2 = BiLSTMAttnIDS(n_features, n_classes).to(DEVICE); set_state_vec(model_D2, calib_def)\n",
    "for _ in range(2):\n",
    "    deltas, weights = [], []\n",
    "    for cid in range(CFG.n_clients):\n",
    "        if cid in poison_ids: continue\n",
    "        local = copy.deepcopy(model_D2); Xc, yc = client_data[cid]\n",
    "        _, d = local_train(local, Xc, yc, 1, CFG.lr, CFG.batch_size); deltas.append(d); weights.append(len(yc))\n",
    "    set_state_vec(model_D2, get_state_vec(model_D2) + fed_avg(deltas, weights))\n",
    "acc_D2, f1_D2, fpr_D2 = evaluate(model_D2, X_te_t, y_te_t)\n",
    "asr_D2 = evaluate_backdoor_asr(model_D2, X_te_t, y_te_t)\n",
    "recovery_prevented_def = max(0.0, min(100.0, (acc_C - acc_D2) / denom * 100))\n",
    "print(f'UnlearnGuard: acc={acc_D2:.2f}%  Backdoor-ASR={asr_D2:.2f}%  Unlearn-ASR={recovery_prevented_def:.1f}%')\n",
    "RESULTS['D'] = {'no_defense': {'acc': acc_D1, 'backdoor_asr': asr_D1, 'unlearn_asr': recovery_prevented_nodef},\n",
    "                'unlearnguard': {'acc': acc_D2, 'f1': f1_D2, 'backdoor_asr': asr_D2, 'unlearn_asr': recovery_prevented_def}}"
   ]
  },
