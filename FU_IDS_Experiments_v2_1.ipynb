  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Cell 8 — Scenario C: FU-IDS Recovery via SlideFU calibration"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def slidefu_calibrate(state_vec, window, target_clients, all_client_sizes):\n",
    "    total = sum(all_client_sizes); correction = torch.zeros_like(state_vec)\n",
    "    for cid in target_clients:\n",
    "        w_c = all_client_sizes[cid] / total\n",
    "        for delta in window.history(cid):\n",
    "            correction = correction + w_c * delta\n",
    "    return state_vec - correction\n",
    "\n",
    "print('=== Scenario C — FU-IDS Recovery (SlideFU) ===')\n",
    "client_sizes = [len(yc) for _, yc in client_data]\n",
    "t0 = time.time()\n",
    "calibrated = slidefu_calibrate(STATE_POISONED, win_B, poison_ids, client_sizes)\n",
    "model_C = BiLSTMAttnIDS(n_features, n_classes).to(DEVICE); set_state_vec(model_C, calibrated)\n",
    "for _ in range(2):\n",
    "    deltas, weights = [], []\n",
    "    for cid in range(CFG.n_clients):\n",
    "        if cid in poison_ids: continue\n",
    "        local = copy.deepcopy(model_C); Xc, yc = client_data[cid]\n",
    "        _, d = local_train(local, Xc, yc, 1, CFG.lr, CFG.batch_size); deltas.append(d); weights.append(len(yc))\n",
    "    set_state_vec(model_C, get_state_vec(model_C) + fed_avg(deltas, weights))\n",
    "T_C = time.time() - t0\n",
    "acc_C, f1_C, fpr_C = evaluate(model_C, X_te_t, y_te_t)\n",
    "asr_C = evaluate_backdoor_asr(model_C, X_te_t, y_te_t)\n",
    "RESULTS['C'] = {'acc': acc_C, 'f1': f1_C, 'fpr': fpr_C, 'backdoor_asr': asr_C,\n",
    "                'wallclock_s': T_C,\n",
    "                'recovery_gap_pct': acc_C - acc_A,\n",
    "                'cost_vs_retrain_pct': T_C / max(T_A, 1e-6) * 100}\n",
    "print(f'C final: acc={acc_C:.2f}%  F1={f1_C:.2f}  FPR={fpr_C:.2f}%  Backdoor-ASR={asr_C:.2f}%  time={T_C:.1f}s')\n",
    "print(f'  Recovery gap (vs A): {acc_C - acc_A:+.2f}%  |  Backdoor reduction: {asr_B - asr_C:+.2f}%')\n",
    "print(f'  Unlearning cost: {T_C / max(T_A, 1e-6) * 100:.1f}% of full retrain')"
   ]
  },
