   "source": [
    "## Cell 6 — Scenario A: FL Baseline (clean training)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "RESULTS = {}\n",
    "print('=== Scenario A — FL Baseline ===')\n",
    "model_A = BiLSTMAttnIDS(n_features, n_classes).to(DEVICE)\n",
    "win_A = GradientWindow(CFG.n_clients)\n",
    "t0 = time.time()\n",
    "hist_A = run_fl(model_A, CFG.n_rounds, poisoning_clients=[], record_window=win_A)\n",
    "T_A = time.time() - t0\n",
    "acc_A, f1_A, fpr_A = evaluate(model_A, X_te_t, y_te_t)\n",
    "asr_A = evaluate_backdoor_asr(model_A, X_te_t, y_te_t)\n",
    "RESULTS['A'] = {'acc': acc_A, 'f1': f1_A, 'fpr': fpr_A, 'backdoor_asr': asr_A, 'wallclock_s': T_A}\n",
    "print(f'A final: acc={acc_A:.2f}%  F1={f1_A:.2f}  FPR={fpr_A:.2f}%  ASR={asr_A:.2f}%  time={T_A:.1f}s')\n",
    "STATE_CLEAN = get_state_vec(model_A).clone()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Cell 7 — Scenario B: FL with Backdoor + Replacement Poisoning (α = 20%)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print('=== Scenario B — FL with Backdoor + Replacement Poisoning ===')\n",
    "n_poison = max(1, int(round(CFG.poison_alpha * CFG.n_clients)))\n",
    "poison_ids = sorted(np.random.RandomState(SEED).choice(CFG.n_clients, size=n_poison, replace=False).tolist())\n",
    "print(f'Poisoning clients: {poison_ids}  (α={CFG.poison_alpha:.0%}, replacement boost={CFG.replacement_boost}×)')\n",
    "print(f'Backdoor: \"{label_enc.classes_[BENIGN_IDX]}\" -> \"{label_enc.classes_[DDOS_IDX]}\"')\n",
    "\n",
    "model_B = BiLSTMAttnIDS(n_features, n_classes).to(DEVICE)\n",
    "win_B = GradientWindow(CFG.n_clients)\n",
    "t0 = time.time()\n",
    "hist_B = run_fl(model_B, CFG.n_rounds, poisoning_clients=poison_ids, record_window=win_B)\n",
    "T_B = time.time() - t0\n",
    "acc_B, f1_B, fpr_B = evaluate(model_B, X_te_t, y_te_t)\n",
    "asr_B = evaluate_backdoor_asr(model_B, X_te_t, y_te_t)\n",
    "RESULTS['B'] = {'acc': acc_B, 'f1': f1_B, 'fpr': fpr_B, 'backdoor_asr': asr_B,\n",
    "                'wallclock_s': T_B, 'poison_ids': poison_ids}\n",
    "print(f'B final: acc={acc_B:.2f}%  F1={f1_B:.2f}  FPR={fpr_B:.2f}%  Backdoor-ASR={asr_B:.2f}%  time={T_B:.1f}s')\n",
    "STATE_POISONED = get_state_vec(model_B).clone()"
   ]
