   "source": [
    "## Cell 10 — Scenario E: norm-clipped DP + MIA verification"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def dp_certify_norm_clipped(unlearned_state, poisoned_state, epsilon, delta, clip_norm):\n",
    "    diff = unlearned_state - poisoned_state\n",
    "    norm = torch.norm(diff).item()\n",
    "    scale = min(1.0, clip_norm / max(norm, 1e-9))\n",
    "    diff_clipped = diff * scale\n",
    "    sensitivity = 2.0 * clip_norm\n",
    "    sigma = sensitivity * math.sqrt(2.0 * math.log(1.25 / delta)) / max(epsilon, 1e-3)\n",
    "    noise = torch.randn_like(diff) * sigma\n",
    "    return poisoned_state + diff_clipped + noise, sigma, norm\n",
    "\n",
    "def shadow_mia_auc(model, Xm, ym, Xn, yn):\n",
    "    model.eval()\n",
    "    def conf(X, y):\n",
    "        with torch.no_grad():\n",
    "            probs = F.softmax(model(X.to(DEVICE)), dim=1)\n",
    "            return probs[range(len(y)), y].cpu().numpy()\n",
    "    cm = conf(Xm, ym); cn = conf(Xn, yn)\n",
    "    scores = np.concatenate([cm, cn])\n",
    "    labels = np.concatenate([np.ones_like(cm), np.zeros_like(cn)])\n",
    "    auc = float(roc_auc_score(labels, scores)) * 100\n",
    "    # Symmetric AUC: report distance from 50% so leakage is interpretable as |auc - 50|\n",
    "    return auc\n",
    "\n",
    "print('=== Scenario E — Privacy Certification (norm-clipped DP) ===')\n",
    "noisy, sigma, pre_clip_norm = dp_certify_norm_clipped(\n",
    "    get_state_vec(model_C), STATE_POISONED, CFG.dp_epsilon, CFG.dp_delta, CFG.dp_clip_norm)\n",
    "model_E = BiLSTMAttnIDS(n_features, n_classes).to(DEVICE); set_state_vec(model_E, noisy)\n",
    "acc_E, f1_E, fpr_E = evaluate(model_E, X_te_t, y_te_t)\n",
    "asr_E = evaluate_backdoor_asr(model_E, X_te_t, y_te_t)\n",
    "\n",
    "if poison_ids:\n",
    "    Xm, ym = client_data[poison_ids[0]]\n",
    "    Xm = Xm[: min(2000, len(Xm))]; ym = ym[: len(Xm)]\n",
    "    Xn = X_te_t[: len(Xm)]; yn = y_te_t[: len(Xm)]\n",
    "    auc_pre = shadow_mia_auc(model_C, Xm, ym, Xn, yn)\n",
    "    auc_post = shadow_mia_auc(model_E, Xm, ym, Xn, yn)\n",
    "    leakage_pre = abs(auc_pre - 50.0)\n",
    "    leakage_post = abs(auc_post - 50.0)\n",
    "else:\n",
    "    auc_pre = auc_post = 50.0; leakage_pre = leakage_post = 0.0\n",
    "\n",
    "RESULTS['E'] = {'acc_after_dp': acc_E, 'f1_after_dp': f1_E, 'backdoor_asr_after_dp': asr_E,\n",
    "                'sigma': sigma, 'epsilon': CFG.dp_epsilon, 'delta': CFG.dp_delta,\n",
    "                'pre_clip_diff_norm': pre_clip_norm, 'clip_norm': CFG.dp_clip_norm,\n",
    "                'mia_auc_pre_dp': auc_pre, 'mia_auc_post_dp': auc_post,\n",
    "                'leakage_pre': leakage_pre, 'leakage_post': leakage_post}\n",
    "print(f'Pre-clip diff L2 norm: {pre_clip_norm:.4f}  (clip_norm={CFG.dp_clip_norm}, σ={sigma:.4f})')\n",
    "print(f'Post-DP: acc={acc_E:.2f}%  F1={f1_E:.2f}  Backdoor-ASR={asr_E:.2f}%')\n",
    "print(f'MIA AUC: pre-DP={auc_pre:.1f}% (leakage={leakage_pre:.1f})  post-DP={auc_post:.1f}% (leakage={leakage_post:.1f})  | 50% = ideal')"
   ]
